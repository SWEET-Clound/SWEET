MEMORY_ENVIRONMENT=development
MEMORY_DATABASE_URL=postgresql+psycopg://memory_app:memory-app-local@127.0.0.1:5432/memory
MEMORY_WORKER_DATABASE_URL=postgresql+psycopg://memory_worker:memory-worker-local@127.0.0.1:5432/memory
MEMORY_JWT_ISSUER=persistent-memory-dev
MEMORY_JWT_AUDIENCE=persistent-memory
MEMORY_DEV_JWT_SECRET=development-only-secret-change-before-sharing-1234
MEMORY_EXTRACTION_MODE=heuristic
MEMORY_MODEL_TIMEOUT_SECONDS=30
MEMORY_MODEL_MAX_ATTEMPTS=2
MEMORY_EVENT_WRITE_LIMIT_PER_MINUTE=120
MEMORY_COMMAND_WRITE_LIMIT_PER_MINUTE=30
